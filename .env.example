# Railway will inject PORT automatically.
PORT=8000

# Add PostgreSQL plugin in Railway, then Railway injects DATABASE_URL automatically.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Optional API key. Leave empty to disable auth during development.
BEFORMA_API_KEY=change-me

# Use your frontend/backend domains in production, comma-separated.
ALLOWED_ORIGINS=*

# Exercise upload settings
BEFORMA_MAX_UPLOAD_MB=200
BEFORMA_SESSION_TTL_SECONDS=3600

# Auto-create DB tables on startup. Good for MVP; replace with Alembic later.
INIT_DB_ON_STARTUP=true

# JSON feedback fallback path used by recommender.py
MEAL_FEEDBACK_PATH=/tmp/meal_feedback.json
